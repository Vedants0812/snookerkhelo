# Copy to .env and fill in.

# MongoDB connection string (MongoDB Atlas or local mongod).
# Leave empty in development to use a built-in local database stored in server/.data
MONGO_URI=

PORT=5000
NODE_ENV=development

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Owner login created on first start (only when no users exist yet). Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Owner
